#!/usr/bin/env sh
set -efu

theme="${1-}"
if [ "$theme" != "dark" ] && [ "$theme" != "light" ]; then
    printf '\033[0;31m%s\033[0m\n' "Error: Invalid argument" >&2
    echo "Usage: $0 [dark|light]" >&2
    exit 1
fi

if [ "$theme" = "dark" ]; then
    kde_theme=org.kde.breezedark.desktop
    # gtk_theme="Adwaita-dark"
    alacritty_theme="everforest_dark_soft"
    bat_config="config-dark"
    delta_theme="theme-dark"
    vim_config='vim.opt.background = "dark"'
else
    kde_theme=org.kde.breeze.desktop
    # gtk_theme="Adwaita"
    alacritty_theme="everforest_light_soft"
    bat_config="config-light"
    delta_theme="theme-light"
    vim_config='vim.opt.background = "light"'
fi

# GTK
# xfconf-query -c xsettings -p /Net/ThemeName -s $gtk_theme

# KDE
case ":${XDG_CURRENT_DESKTOP-}:" in
*:KDE:*) plasma-apply-lookandfeel -a "$kde_theme" ;;
esac

# Alacritty
cd "$HOME/.config/alacritty"
ln -sf themes/$alacritty_theme.toml current_theme.toml
touch alacritty.toml

# Preserve pane dimming when switching themes
if tmux has-session 2>/dev/null; then
    tmux set-option -gw window-style \
        'fg=terminal,bg=terminal,dim=40%'
    tmux set-option -gw window-active-style \
        'fg=terminal,bg=terminal,dim=0%'
fi

# Bat
cd "$HOME/.config/bat"
ln -sf $bat_config config

# Delta
cd "$HOME/.config/git-delta"
ln -sf $delta_theme.ini theme.ini

# Vim
echo "$vim_config" >~/.config/nvim/theme.lua

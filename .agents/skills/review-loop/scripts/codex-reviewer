#!/bin/sh
set -eu

if [ ! -d "./var" ]; then
    mkdir ./var
    printf '%s\n' '*' >./var/.gitignore
    printf '%s\n' '!*' >./var/.ignore
fi

mkdir -p ./var/review
exec codex --sandbox read-only --model "$1" \
    -c "review_model=\"$1\"" \
    -c "model_reasoning_effort=\"$2\"" review "
$3
Do not run checks or tests, assume they all valid.
" >./var/review/stdout 2>./var/review/stderr
